<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- MAIN APP THEME -->
    <style name="Theme.HugYourMug" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Disable action bar -->
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Primary colors -->
        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorPrimaryVariant">@color/coffee_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary palette -->
        <item name="colorSecondary">@color/coffee_light_brown</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/coffee_dark</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/coffee_cream</item>

        <!-- Bottom navigation -->
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>

    </style>

    <!-- BOTTOM NAVIGATION STYLE -->
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="android:background">@color/white</item>
    </style>

</resources>
