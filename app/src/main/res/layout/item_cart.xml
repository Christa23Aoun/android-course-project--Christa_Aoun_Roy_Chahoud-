<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#1A1A1A"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- Coffee Image -->
    <ImageView
        android:id="@+id/imgCartCoffee"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/espresso"
        android:layout_marginEnd="12dp" />

    <!-- Text + Buttons Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtCartItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Espresso"
            android:textColor="#F5D0A9"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCartItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$3.0"
            android:textColor="@android:color/white"
            android:layout_marginTop="2dp" />

        <!-- Quantity row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Minus -->
            <ImageView
                android:id="@+id/btnDecrease"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/round_brown"
                android:padding="8dp"
                android:src="@drawable/ic_remove"
                android:backgroundTintMode="src_in" />

            <!-- Quantity -->
            <TextView
                android:id="@+id/txtCartQuantity"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"/>

            <!-- Plus -->
            <ImageView
                android:id="@+id/btnIncrease"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/round_brown"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                android:backgroundTintMode="src_in" />

        </LinearLayout>
    </LinearLayout>

    <!-- Trash -->
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/round_red"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        android:layout_marginStart="12dp"
        android:backgroundTintMode="src_in" />

</LinearLayout>
